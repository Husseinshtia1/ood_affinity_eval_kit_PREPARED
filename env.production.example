# PREPARED.ai production environment example

# API
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=replace-with-secure-secret
JWT_SECRET=replace-with-secure-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+psycopg://user:password@db:5432/prepared

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email / SMTP
SMTP_HOST=smtp.provider.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=noreply@prepared.ai

# AWS / S3
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
S3_BUCKET=prepared-production

# Security
RATE_LIMIT_ENABLED=true
AUDIT_LOG_ENABLED=true
